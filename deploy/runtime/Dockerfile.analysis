FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY analysis-service/requirements.txt requirements.txt
RUN pip install --index-url https://mirrors.cloud.tencent.com/pypi/simple --no-cache-dir -r requirements.txt
COPY analysis-service/app app
COPY analysis-service/config config
RUN useradd -u 10001 -m app && mkdir -p /app/.data && chown -R app:app /app
USER 10001
CMD ["python","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8090","--workers","1"]
